# ============================================================================
# Claw 生产环境变量模板（复制为 deploy/.env.prod 后填真实值）
# 注意：本文件含密钥，禁止提交到 git（已默认忽略，见项目 .gitignore）。
# ============================================================================

# ---------- 版本切换核心 ----------
# 切换部署版本只改这一行：CLAW_VERSION=v1.2.3，然后 `docker compose ... up -d`
# 后端与前端共用同一版本号，保证前后端版本对齐。
CLAW_VERSION=latest

# 镜像仓库：私有 registry / 云容器镜像服务地址（如 registry.cn-hangzhou.aliyuncs.com/yourns）
# 留空则表示使用本机 docker build 出的本地镜像（scripts/deploy-version.sh build）。
DOCKER_REGISTRY=

# ---------- 数据库（PostgreSQL / TimescaleDB）----------
DB_NAME=claw
DB_USER=claw
DB_PASSWORD=__CHANGE_ME_DB__

# ---------- 缓存 / 消息队列 ----------
MQ_USER=claw
MQ_PASSWORD=__CHANGE_ME_MQ__

# ---------- 安全密钥（生产必须改为强随机值，建议用密钥管理，不要明文落库）----------
# JWT 签名密钥，长度 ≥ 32 字节
CLAW_JWT_SECRET=__CHANGE_ME_JWT_32BYTES_MIN__
# 身份证号 AES-256-GCM 加密密钥
CLAW_ID_CARD_KEY=__CHANGE_ME_IDCARD_AES256__
# 支付网关回调共享密钥（fail-closed：未配置则回调接口拒绝服务）
CLAW_PAYMENT_CALLBACK_SECRET=__CHANGE_ME_CALLBACK_SECRET__
