# ============================================================================
# Claw 测试环境变量模板（腾讯云轻量应用服务器 · 仅测试用途）
# 复制为 deploy/.env.test 或 /opt/claw/.env.test 后填入真实值。
# ⚠️ 含密钥，禁止提交到 git（deploy/.env.test 已加入 .gitignore）。
# ============================================================================

# ---------- 版本 / 镜像仓库 ----------
# 服务器本地构建时 DOCKER_REGISTRY 留空即可（compose 默认回落到 claw）。
DOCKER_REGISTRY=claw
CLAW_VERSION=test

# ---------- 数据库（PostgreSQL / TimescaleDB）----------
DB_NAME=claw
DB_USER=claw
DB_PASSWORD=__CHANGE_ME_DB__

# ---------- 消息队列 ----------
MQ_USER=claw
MQ_PASSWORD=__CHANGE_ME_MQ__

# ---------- EMQX 控制台默认密码（容器内 18083，默认不对宿主暴露）----------
EMQX_DASHBOARD_PASSWORD=__CHANGE_ME_EMQX__

# ---------- 安全密钥（测试环境也请用随机值，勿留示例串）----------
# JWT 签名密钥，长度 ≥ 32 字节
CLAW_JWT_SECRET=__CHANGE_ME_JWT_32BYTES_MIN__
# 身份证号 AES-256-GCM 加密密钥
CLAW_ID_CARD_KEY=__CHANGE_ME_IDCARD_AES256__
# 支付网关回调共享密钥（fail-closed：未配置则回调接口恒 401）
CLAW_PAYMENT_CALLBACK_SECRET=__CHANGE_ME_CALLBACK_SECRET__
